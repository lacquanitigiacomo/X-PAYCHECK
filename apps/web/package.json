    "postcss": "^8.4.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.4",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
