NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-a-random-local-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Copiare in apps/web/.env. Deve corrispondere a GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Copiare in apps/mobile/.env. Su Android Emulator usare 10.0.2.2;
# su un dispositivo fisico usare l'indirizzo LAN del computer.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

DB_HOST=localhost
DB_PORT=5432
DB_NAME=x_paycheck_development
DB_USER=x_paycheck_dev
DB_PASSWORD=replace-with-a-local-password
